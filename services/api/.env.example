# Copy to .env for local development. Never commit a real .env file.
EVALFORGE_ENVIRONMENT=local
EVALFORGE_LOG_LEVEL=INFO
EVALFORGE_HOST=0.0.0.0
EVALFORGE_PORT=8000

# Administrative DSN: migrations and readiness checks only.
EVALFORGE_DATABASE_URL=postgresql://evalforge:evalforge-local-dev@localhost:5432/evalforge

# Least-privilege DSN the running application uses for every request.
# The evalforge_app role is created by the identity-and-tenancy
# migration from EVALFORGE_APP_DB_PASSWORD below — run migrations
# before starting the API with this value.
EVALFORGE_APP_DATABASE_URL=postgresql://evalforge_app:evalforge-app-local-dev@localhost:5432/evalforge
EVALFORGE_APP_DB_PASSWORD=evalforge-app-local-dev

EVALFORGE_REDIS_URL=redis://localhost:6379/0

EVALFORGE_OBJECT_STORAGE_ENDPOINT_URL=http://localhost:9000
EVALFORGE_OBJECT_STORAGE_ACCESS_KEY=evalforge-local-dev
EVALFORGE_OBJECT_STORAGE_SECRET_KEY=evalforge-local-dev-secret
EVALFORGE_OBJECT_STORAGE_BUCKET=evalforge-local
EVALFORGE_OBJECT_STORAGE_REGION=us-east-1
EVALFORGE_OBJECT_STORAGE_USE_TLS=false

EVALFORGE_CORS_ALLOWED_ORIGINS=["http://localhost:3000"]

EVALFORGE_MAX_REQUEST_BODY_BYTES=2000000
EVALFORGE_RATE_LIMIT_REQUESTS_PER_WINDOW=60
EVALFORGE_RATE_LIMIT_WINDOW_SECONDS=60

# Generate a real value with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Must be at least 32 characters. Never reuse the same key across environments.
EVALFORGE_JWT_SIGNING_KEY=
EVALFORGE_JWT_ISSUER=evalforge
EVALFORGE_JWT_AUDIENCE=evalforge-api
EVALFORGE_JWT_ACCESS_TOKEN_TTL_SECONDS=900
